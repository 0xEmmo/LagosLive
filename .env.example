NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Shared secret Paystack signs webhooks with (HMAC-SHA512 over the raw body,
# checked against the x-paystack-signature header). Reuse of PAYSTACK_SECRET_KEY
# is the Paystack default, so this only needs setting if the dashboard is
# configured with a separate signing key.
PAYSTACK_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token required by /api/cron/* so a scheduled job can be triggered
# without a Supabase session. Must be set to a long random value.
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
